  <object name="pudim_quartelQtd" type="dropdown" style="ModernDropDown" size="55%+4 626 100%-8 654" tooltip="Quantos construir (1 a 10)"><action on="SelectionChange">pudim_QuartelSetQtd();</action></object>
  <object name="pudim_quartelBtn" type="button" size="8 658 100%-8 682" style="StoneButton" tooltip="Ergue um de cada vez, com 5 trabalhadores do recurso mais abundante. Eles voltam ao trabalho ao terminar."><action on="Press">pudim_QuartelToggle();</action><object name="pudim_quartelBtnLabel" type="text" size="0 0 100% 100%" font="sans-bold-13" text_align="center" text_valign="center" textcolor="200 160 255 255" ghost="true"><translatableAttribute id="caption">Construir 1 Quartel</translatableAttribute></object></object>

