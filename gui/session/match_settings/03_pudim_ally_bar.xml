<?xml version="1.0" encoding="utf-8"?>
<!-- z=-1: o chatPanel do jogo é z=0 (gui/session/session.xml:46). Com o z=9999 anterior
     a barra cobria o chat e atrapalhava a leitura; agora fica atrás dele. -->
<!-- topo 56 -> 36: encosta a barra na barra superior do jogo, sem o vão que havia entre elas -->
<object name="pudimAllyBar" hidden="true" absolute="true" size="50%-440 36 50%+500 100%" z="-1" ghost="true">
    <repeat count="9" var="n">
        <object name="pudimAllyRow[n]" hidden="true" size="0 0 100% 26" type="image" sprite="color: 0 0 0 140" ghost="true">
            <!-- Separador -->
            <object type="image" size="0 25 100% 26" sprite="color: 255 255 255 20" ghost="true"/>

            <!-- LINHA UNICA (Y: 2 a 24) -->
            <!-- Nome e Pop -->
            <object name="pudimAllyName[n]" type="text" size="10 2 130 24" font="sans-bold-14" textcolor="white" ghost="true"/>
            <object name="pudimAllyPop[n]" type="text" size="135 2 180 24" font="sans-bold-14" textcolor="white" ghost="true"/>
            
            <!-- Comida -->
            <object type="image" size="190 4 206 20" sprite="stretched:session/icons/resources/food.png" ghost="true"/>
            <object name="pudimAllyFood[n]" type="text" size="210 2 290 24" font="sans-bold-13" textcolor="255 210 70 255" ghost="true"/>
            
            <!-- Madeira -->
            <object type="image" size="300 4 316 20" sprite="stretched:session/icons/resources/wood.png" ghost="true"/>
            <object name="pudimAllyWood[n]" type="text" size="320 2 400 24" font="sans-bold-13" textcolor="110 215 70 255" ghost="true"/>
            
            <!-- Pedra -->
            <object type="image" size="410 4 426 20" sprite="stretched:session/icons/resources/stone.png" ghost="true"/>
            <object name="pudimAllyStone[n]" type="text" size="430 2 510 24" font="sans-bold-13" textcolor="175 175 175 255" ghost="true"/>
            
            <!-- Metal -->
            <object type="image" size="520 4 536 20" sprite="stretched:session/icons/resources/metal.png" ghost="true"/>
            <object name="pudimAllyMetal[n]" type="text" size="540 2 620 24" font="sans-bold-13" textcolor="140 195 220 255" ghost="true"/>

            <!-- Exercito -->
            <object name="pudimAllyArmy[n]" type="text" size="630 2 800 24" font="sans-12" textcolor="200 200 200 255" ghost="true"/>

            <!-- KD -->
            <object name="pudimAllyKD[n]" type="text" size="802 2 940 24" font="sans-bold-13" textcolor="white" ghost="true"/>

            <!-- Overlay para Flash -->
            <object name="pudimAllyBgOverlay[n]" type="image" size="0 0 100% 100%" sprite="color: 0 0 0 0" ghost="true"/>
        </object>
    </repeat>
</object>
