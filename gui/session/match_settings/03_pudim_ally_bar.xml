<?xml version="1.0" encoding="utf-8"?>
<!-- z=-1: o chatPanel do jogo é z=0 (gui/session/session.xml:46). Com o z=9999 anterior
     a barra cobria o chat e atrapalhava a leitura; agora fica atrás dele. -->
<!-- topo 56 -> 36: encosta a barra na barra superior do jogo, sem o vão que havia entre elas -->
<object name="pudimAllyBar" hidden="true" absolute="true" size="50%-440 36 50%+500 100%" z="-1" ghost="true">
    <repeat count="9" var="n">
        <object name="pudimAllyRow[n]" hidden="true" size="0 0 100% 26" type="image" sprite="color: 0 0 0 140" ghost="true">
            <!-- Separador -->
            <object type="image" size="0 25 100% 26" sprite="color: 255 255 255 20" ghost="true"/>

            <!-- LINHA UNICA (Y: 2 a 24) -->
            <!-- LARGURAS, e por que estas.
            
                 Relato de 08/09: "quando o nick e grande, cai de linha, tb a parte de
                 populacao/capacidade quanto tem mais de 3 caracteres de cada, corta o ultimo, ex
                 200/200 aparece 200/20".
            
                 Os dois campos estavam apertados desde sempre, e o prefixo de equipe ("T1 "), que
                 entrou em 06/09 para o modo observador, consumiu o que restava do nome.
            
                 Medida do que nao cabia, que e o unico numero confiavel aqui:
                   "200/200"           7 caracteres nao cabiam em  45px  em sans-bold-14
                   "T1 tesla2402  III" 17 caracteres nao cabiam em 120px em sans-bold-14
            
                 Isso da um piso de ~6,4 e ~7,1 px por caractere. Trabalhando com 9 px/caractere em
                 sans-bold-14 (folga deliberada, porque medir fonte por captura de tela e chute):
            
                   nome  175px = 19 caracteres; o pior caso e "T1 " + 14 do nick + "  III" = 22.
                         Por isso o corte do nick caiu de 16 para 14 em pudim_ally_bar.js.
                   pop    74px; a legenda inteira e "200/200 +0" (10 caracteres, digitos
            estreitos: regua de 7 px/caractere). O maximo da partida saiu dela — era
            o mesmo "(200)" em todas as linhas, e era ele que cortava o resto.
            
                 O espaco saiu de Exercito e K/D, que sobravam, e a barra continua terminando em 940 —
                 nao ficou mais larga. tools/test_ally_bar_layout.js confere que nenhum campo invade o
                 vizinho e que tudo cabe. -->
            <!-- Nome e Pop -->
            <object name="pudimAllyName[n]" type="text" size="10 2 185 24" font="sans-bold-14" textcolor="white" ghost="true"/>
            <object name="pudimAllyPop[n]" type="text" size="190 2 264 24" font="sans-bold-14" textcolor="white" ghost="true"/>
            
            <!-- Comida -->
            <object type="image" size="270 4 286 20" sprite="stretched:session/icons/resources/food.png" ghost="true"/>
            <object name="pudimAllyFood[n]" type="text" size="290 2 362 24" font="sans-bold-13" textcolor="255 210 70 255" ghost="true"/>
            
            <!-- Madeira -->
            <object type="image" size="368 4 384 20" sprite="stretched:session/icons/resources/wood.png" ghost="true"/>
            <object name="pudimAllyWood[n]" type="text" size="388 2 460 24" font="sans-bold-13" textcolor="110 215 70 255" ghost="true"/>
            
            <!-- Pedra -->
            <object type="image" size="466 4 482 20" sprite="stretched:session/icons/resources/stone.png" ghost="true"/>
            <object name="pudimAllyStone[n]" type="text" size="486 2 558 24" font="sans-bold-13" textcolor="175 175 175 255" ghost="true"/>
            
            <!-- Metal -->
            <object type="image" size="564 4 580 20" sprite="stretched:session/icons/resources/metal.png" ghost="true"/>
            <object name="pudimAllyMetal[n]" type="text" size="584 2 656 24" font="sans-bold-13" textcolor="140 195 220 255" ghost="true"/>

            <!-- Exercito -->
            <object name="pudimAllyArmy[n]" type="text" size="662 2 826 24" font="sans-12" textcolor="200 200 200 255" ghost="true"/>

            <!-- KD -->
            <object name="pudimAllyKD[n]" type="text" size="830 2 940 24" font="sans-bold-13" textcolor="white" ghost="true"/>

            <!-- Overlay para Flash -->
            <object name="pudimAllyBgOverlay[n]" type="image" size="0 0 100% 100%" sprite="color: 0 0 0 0" ghost="true"/>
        </object>
    </repeat>
</object>
