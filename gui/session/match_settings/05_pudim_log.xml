<?xml version="1.0" encoding="utf-8"?>
<!--
  PudimMod - Painel de Debug/Log
  Painel flutuante exibindo as últimas ações do mod com cores por categoria e nível.
  Toggle: botão "Log" no pudim_mainPanel (02_pudim_panel.xml).
-->
<object
  name="pudimLogPanel"
  hidden="true"
  z="160"
  size="350 24 100%-10 100%-10">

  <!-- Fundo semi-transparente -->
  <object type="image" sprite="color: 4 4 8 230" size="0 0 100% 100%"/>

  <!-- Barra de cabeçalho -->
  <object type="image" sprite="color: 18 22 35 255" size="0 0 100% 24"/>

  <object type="text"
    size="8 0 60% 24"
    font="sans-bold-12"
    textcolor="190 200 220 255"
    text_align="left"
    text_valign="center"
    ghost="true">
    <translatableAttribute id="caption">PudimMod — Debug Log</translatableAttribute>
  </object>

  <!-- Botão Limpar -->
  <object name="pudimLogClearBtn"
    type="button"
    size="100%-112 2 100%-58 22"
    style="StoneButton"
    tooltip="Limpa o buffer de log">
    <action on="Press">pudim_ClearLog();</action>
    <translatableAttribute id="caption">Limpar</translatableAttribute>
  </object>

  <!-- Botão Fechar -->
  <object name="pudimLogCloseBtn"
    type="button"
    size="100%-54 2 100%-4 22"
    style="StoneButton"
    tooltip="Fechar painel de log">
    <action on="Press">pudim_ToggleLog();</action>
    <translatableAttribute id="caption">X</translatableAttribute>
  </object>

  <!-- Área de texto do log -->
  <object
    name="pudimLogText"
    type="text"
    font="mono-10"
    size="6 28 100%-6 100%-4"
    textcolor="180 180 180 255"
    text_align="left"
    text_valign="top"
    ghost="true"/>

</object>
